      "metadata": {
        "id": "KbyQ9mMCP18k"
      },
      "outputs": [],
      "source": [
        "import pandas as pd\n",
        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "# this function loads the dataset and shows the first rows\n",
        "# this helps me see how the data looks at the beginning\n",
        "def load_data(path):\n",
        "    df = pd.read_csv(\"/AmesHousing.csv\")\n",
        "    print(\"first 5 rows\")\n",
        "    print(df.head())\n",
        "    return df"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# here i load the file and print the first rows\n",
        "# this helps me quickly see the columns and values\n",
        "def load_data(path):\n",
        "    df = pd.read_csv(\"/AmesHousing.csv\")\n",
        "    # remove extra spaces from column names\n",
        "    df.columns = df.columns.str.strip()\n",
        "    print(\"first 5 rows\",df.head())\n",
        "    return df"
      ],
      "metadata": {
        "id": "QwnKGHQdQFTR"
      },
      "execution_count": 9,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# this function prints number of rows and columns\n",
        "# this helps me understand the size of the dataset\n",
        "def check_shape(df):\n",
        "    print(\"dataset shape\")\n",
        "    print(\"rows:\", df.shape[0])\n",
        "    print(\"columns:\", df.shape[1])\n",
        "    return df"
      ],
      "metadata": {
        "id": "dSfB7AqvRLdG"
      },
      "execution_count": 10,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# here i use info() to check data types and missing values\n",
        "# this helps me see if some columns have wrong types\n",
        "def inf_types(df):\n",
        "    print(\"data types info\",df.info())\n",
        "    return df"
      ],
      "metadata": {
        "id": "ZJ8sdmOeRQPI"
      },
      "execution_count": 11,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# here i check numeric columns even if they already look correct\n",
        "# sometimes datasets read numbers as text so i make sure they are numeric\n",
        "def fix_type(df):\n",
        "    df[\"total_rooms\"] = pd.to_numeric(df[\"total_rooms\"], errors=\"coerce\")\n",
        "    df[\"total_bedrooms\"] = pd.to_numeric(df[\"total_bedrooms\"], errors=\"coerce\")\n",
        "    print(\"checked numeric types for rooms columns\")\n",
        "    return df"
      ],
      "metadata": {
        "id": "cZoBABv5RYiH"
      },
      "execution_count": 12,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# here i count missing values in every column\n",
        "# this helps me know which columns need cleaning\n",
        "def missing_values(df):\n",
        "    print(\"missing values per column\")\n",
        "    print(df.isnull().sum())\n",
        "    return df"
      ],
      "metadata": {
        "id": "xDHlR2doRge8"
      },
      "execution_count": 13,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# here i fill missing values based on the column type\n",
        "# lot frontage is a numeric column\n",
        "# i use median because it is better when data has outliers because it is robust to outliers and skewed data\n",
        "# median is more stable than mean\n",
        "def handle_missing(df):\n",
        "    df[\"total_bedrooms\"] = df[\"total_bedrooms\"].fillna(df[\"total_bedrooms\"].median())\n",
        "    print(\"handled missing values in total_bedrooms\")\n",
        "    return df"
      ],
      "metadata": {
        "id": "5-eWniaERkn9"
      },
      "execution_count": 14,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# here i check if there are duplicate rows\n",
        "# duplicates can affect analysis so i remove them\n",
        "def handle_duplicates(df):\n",
        "    print(\"duplicate rows:\", df.duplicated().sum())\n",
        "    df = df.drop_duplicates()\n",
        "    print(\"shape after removing duplicates:\", df.shape)\n",
        "    return df"
      ],
      "metadata": {
        "id": "sVZ3dsWtSXVw"
      },
      "execution_count": 15,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# here i check outliers in the target column saleprice\n",
        "# i also calculate the iqr\n",
        "\n",
        "def handle_outliers(df):\n",
        "    # boxplot to see outliers visually\n",
        "    sns.boxplot(x=df[\"median_house_value\"])\n",
        "    plt.title(\"boxplot of  median house value\")\n",
        "    plt.show()\n",
        "    # calculate q1 and q3\n",
        "    q1 = df[\"median_house_value\"].quantile(0.25)\n",
        "    q3 = df[\"median_house_value\"].quantile(0.75)\n",
        "    # calculate iqr\n",
        "    iqr = q3 - q1\n",
        "    print(\"iqr value:\", iqr)\n",
        "    return df"
      ],
      "metadata": {
        "id": "jYz06_oKScdm"
      },
      "execution_count": 16,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# final checks to confirm data looks correct\n",
        "def final_checks(df):\n",
        "    print(\"nullsss in target:\", df[\"median_house_value\"].isnull().sum())\n",
        "    print(\"all target values > 0:\", (df[\"median_house_value\"] > 0).all())\n",
        "    print(\"total columns:\", df.shape[1])\n",
        "    return df"
      ],
      "metadata": {
        "id": "7eAXQI1lVvsB"
      },
      "execution_count": 17,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# this function runs all cleaning steps in order\n",
        "def cleaning_pipeline(path):\n",
        "    df = load_data(path)\n",
        "    df = check_shape(df)\n",
        "    df = inf_types(df)\n",
        "    df = fix_type(df)\n",
        "    df = missing_values(df)\n",
        "    df = handle_missing(df)\n",
        "    df = handle_duplicates(df)\n",
        "    df = handle_outliers(df)\n",
        "    df = final_checks(df)\n",
        "    print(\"cleaning done\")\n",
        "    return df"
      ],
      "metadata": {
        "id": "ukMuzOwqSviY"
      },
      "execution_count": 18,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "clean_df = cleaning_pipeline(\"/AmesHousing.csv\")"
      ],
